#!/bin/bash
set -e

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP_DIR="${TRIM_APPDEST:-$PROJECT_DIR/app}"
APP_VAR="${TRIM_PKGVAR:-$APP_DIR/var}"
APP_HOME="${TRIM_PKGHOME:-$APP_DIR/home}"
PID_FILE="$APP_VAR/montube.pid"
LOG_FILE="$APP_VAR/montube.log"
PYTHON_ROOT="/var/apps/python312/target/bin"
DATA_SHARE="${TRIM_DATA_SHARE_PATHS%%:*}"
[ -n "$DATA_SHARE" ] || DATA_SHARE="$APP_VAR/downloads"
SOCKET_PATH="$APP_DIR/app.sock"
VENV="$APP_HOME/venv"

export PATH="$PYTHON_ROOT:$PATH"
export MONTUBE_DOWNLOAD_DIR="$DATA_SHARE"
export MONTUBE_DB_PATH="$APP_VAR/montube.db"
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "$LOG_FILE" >&2
}

read_pid() {
  [ -f "$PID_FILE" ] && cat "$PID_FILE"
}

# 旧版本的安装脚本可能没把虚拟环境建好，这里自动补齐，避免服务起不来导致界面空白。
ensure_venv() {
  if [ -x "$VENV/bin/uvicorn" ] && "$VENV/bin/python" -c 'import fastapi, uvicorn, pydantic, yt_dlp' 2>/dev/null; then
    return 0
  fi
  log "Python environment is missing or incomplete, rebuilding it."
  [ -d "$APP_DIR/wheels/x86_64" ] || { log "Bundled wheels are missing: $APP_DIR/wheels/x86_64"; return 1; }
  case "$(uname -m)" in
    x86_64|amd64|x86|x64) ;;
    *) log "Montube only supports x86_64; detected $(uname -m)."; return 1 ;;
  esac
  rm -rf "$VENV"
  "$PYTHON_ROOT/python3" -m venv "$VENV" || "$PYTHON_ROOT/python3.12" -m venv "$VENV" || python3 -m venv "$VENV"
  "$VENV/bin/pip" install --disable-pip-version-check --no-index --find-links "$APP_DIR/wheels/x86_64" --only-binary=:all: -r "$APP_DIR/requirements.txt"
  chmod 700 "$VENV"
}

# fnOS 的文件服务只认每个共享文件夹根目录下的 .ui 链接，链接到应用的 UI 包。
# 如果链接缺失过，应用的图标/入口都打不开，只会得到一个空白窗口。
ensure_ui_links() {
  local root
  for root in $(echo "${TRIM_DATA_SHARE_PATHS:-}" | tr ':' ' '); do
    [ -d "$root" ] || continue
    if [ ! -e "$root/.ui" ] && [ ! -L "$root/.ui" ]; then
      ln -s "$APP_DIR/ui" "$root/.ui" 2>/dev/null && log "Linked $root/.ui -> $APP_DIR/ui"
    fi
  done
}

case "${1:-}" in
  start)
    mkdir -p "$APP_VAR" "$APP_HOME"
    if [ -n "$(read_pid)" ] && kill -0 "$(read_pid)" 2>/dev/null; then exit 0; fi
    ensure_venv || { log "Montube Python environment is unavailable; reinstall or repair the app."; exit 1; }
    ensure_ui_links
    rm -f "$SOCKET_PATH"
    log "Starting Montube $(grep -m1 '^version=' "$PROJECT_DIR/manifest" 2>/dev/null || echo '') from $APP_DIR"
    "$VENV/bin/uvicorn" main:app --app-dir "$APP_DIR" --uds "$SOCKET_PATH" >>"$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    for _ in $(seq 1 30); do
      if kill -0 "$(read_pid)" 2>/dev/null; then sleep 1; else log "Montube exited during startup."; tail -n 50 "$LOG_FILE" >&2; exit 1; fi
      if [ -S "$SOCKET_PATH" ]; then log "Montube started on $SOCKET_PATH"; exit 0; fi
    done
    log "Montube did not become ready; inspect $LOG_FILE"
    exit 1
    ;;
  stop)
    pid="$(read_pid || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
    rm -f "$PID_FILE"
    rm -f "$SOCKET_PATH"
    ;;
  status)
    pid="$(read_pid || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then exit 0; fi
    exit 3
    ;;
  *) echo "Usage: $0 {start|stop|status}" >&2; exit 1 ;;
esac
